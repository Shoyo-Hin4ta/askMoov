exports[`compiler > snapshot: absent_count 1`] = `
{
  "caveats": [],
  "params": [
    "2026-09-14",
    "2026-10-13",
    42,
  ],
  "shape": "scalar",
  "sql": "SELECT
  (count(*) filter (where status = 'absent'))::int AS value
FROM analytics.v_attendance_daily
WHERE date >= $1::date AND date < ($2::date + 1)
  AND section_id = $3
ORDER BY 1
LIMIT 100",
}
`;

exports[`compiler > snapshot: attendance_rate_by_week 1`] = `
{
  "caveats": [],
  "params": [
    "2026-09-14",
    "2026-10-13",
    1203,
  ],
  "shape": "series",
  "sql": "SELECT
  date_trunc('week', date)::date AS week,
  avg(case when status in ('present','tardy') then 1.0 else 0.0 end) AS value
FROM analytics.v_attendance_daily
WHERE date >= $1::date AND date < ($2::date + 1)
  AND student_id = $3
GROUP BY 1
ORDER BY week ASC
LIMIT 100",
}
`;


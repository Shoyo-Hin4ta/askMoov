exports[`compiler > snapshot: dwell_minutes 1`] = `
{
  "caveats": [
    "inferred_from_next_tap",
  ],
  "params": [
    "2026-09-14",
    "2026-10-13",
    1203,
  ],
  "shape": "categories",
  "sql": "SELECT
  location_id AS room,
  coalesce(sum(extract(epoch from (left_by - arrived_at)) / 60.0), 0) AS value
FROM analytics.v_presence
WHERE arrived_at >= $1::timestamptz AND arrived_at < ($2::date + 1)::timestamptz
  AND student_id = $3
GROUP BY 1
ORDER BY value DESC
LIMIT 100",
}
`;


exports[`compiler > snapshot: who_was_where 1`] = `
{
  "caveats": [
    "inferred_from_next_tap",
  ],
  "params": [
    "2026-09-14",
    "2026-10-13",
    "2026-10-13T14:10:00Z",
    "Gym",
  ],
  "shape": "rows",
  "sql": "SELECT student_id, location, arrived_at, left_by, left_by_kind
FROM (
  SELECT DISTINCT ON (student_id) student_id, location, arrived_at, left_by, left_by_kind
  FROM analytics.v_presence
  WHERE arrived_at <= $3
    AND arrived_at >= $1::timestamptz AND arrived_at < ($2::date + 1)::timestamptz
  ORDER BY student_id, arrived_at DESC
) last
WHERE location = $4
  AND (left_by IS NULL OR left_by > $3)
ORDER BY arrived_at DESC
LIMIT 100",
}
`;

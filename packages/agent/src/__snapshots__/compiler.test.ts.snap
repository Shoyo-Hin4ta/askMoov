exports[`compiler > snapshot: entry_count_minute 1`] = `
{
  "caveats": [],
  "params": [
    "2026-09-14",
    "2026-10-13",
  ],
  "shape": "series",
  "sql": "SELECT
  to_char(date_trunc('hour', ts) + make_interval(mins => (extract(minute from ts)::int / 5) * 5), 'HH24:MI') AS minute_bucket,
  count(*)::int AS value
FROM analytics.v_entry
WHERE ts >= $1::timestamptz AND ts < ($2::date + 1)::timestamptz
GROUP BY 1
ORDER BY minute_bucket ASC
LIMIT 100",
}
`;


DATABASE_URL_ADMIN=postgresql://postgres:...   # superuser, migrations and seed only
DATABASE_URL_APP=postgres://ask_moov_app:...
DATABASE_URL_QUERY=postgres://ask_moov_query:...
ANTHROPIC_API_KEY=
APP_URL=http://localhost:3100
WORKER_SECRET=change-me
MONTHLY_TOKEN_BUDGET=50000000
RUN_TOKEN_CAP=150000
EPISODES_ENABLED=true
CHAOS_ENABLED=false
# VERCEL_GIT_COMMIT_SHA is set by Vercel; locally the app falls back to `git rev-parse HEAD`
